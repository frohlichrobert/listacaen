# listacaen.ro - site PHP. Orice URL care nu e fișier real ajunge în index.php.

Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# http -> https si www -> fara www, intr-un singur pas
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://listacaen.ro%{REQUEST_URI} [L,R=301]

# nu servi direct codul si datele
RewriteRule ^(inc|data|bin)(/|$) - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 day"
</IfModule>
